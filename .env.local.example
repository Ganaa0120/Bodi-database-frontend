# Backend API-ийн бодит URL. ЗААВАЛ "BACKEND_URL" (NEXT_PUBLIC_ хагас биш) —
# ингэснээр энэ утга browser JS bundle рүү орохгүй, зөвхөн Next.js server дээр
# (Route Handler-үүд дотор) ашиглагдана. Азурегийн backend-ийн бодит хаяг
# хэзээ ч browser рүү шууд харагдахгүй.
BACKEND_URL=http://localhost:4000

# Cookie-г "secure" болгох эсэх. Production (HTTPS) дээр заавал true байх ёстой.
# Локал http://localhost дээр турших үед false байх шаардлагатай — үгүй бол
# browser cookie-г огт хадгалахгүй.
COOKIE_SECURE=false
